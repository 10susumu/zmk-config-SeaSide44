#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/* レイヤー番号に名前を定義（管理が圧倒的に楽になります） */
#define L_CS   1    // CUSTOM
#define L_NM   2    // NUMBER
#define L_SY   3    // SYMBOL
#define L_SC   4    // SHORTCUT
#define L_CF   5    // BLUETOOTH
#define L_SR   6    // SCROLL

#define CUSTOM   1    // CUSTOM
#define NUMBER   2    // NUMBER
#define SYMBOL   3    // SYMBOL
#define SHORTCUT   4    // SHORTCUT
#define BLUETOOTH   5    // BLUETOOTH
#define SCROLL   6    // SCROLL

&mt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

&lt {
    flavor = "balanced";
    quick-tap-ms = <300>;
};

/ {
    combos { compatible = "zmk,combos"; };

    macros {
        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&to 0 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_LAYER_0";
        };
    };

    behaviors {
        lt_to_layer_0: lt_to_layer_0 {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_TO_0";
            bindings = <&mo>, <&to_layer_0>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };
    };


/* 矢印キーの短縮定義 */
// #define UP     UP_ARROW
// #define DOWN   DOWN_ARROW
// #define LEFT   LEFT_ARROW
#define RGHT   RIGHT_ARROW

/* キー名・単語の短縮定義 */
#define ENT    ENTER
// #define ESC    ESCAPE
// #define SPC    SPACE
#define MINS   MINUS
// #define EQL    EQUAL
#define QUES   QUESTION
#define PSCR   PRINTSCREEN
// #define PGUP   PAGE_UP
// #define PGDN   PAGE_DOWN
#define COMM   COMMA
#define SLSH   SLASH
#define ASTR   ASTERISK
#define UNDS   UNDERSCORE
// #define TILD   TILDE
#define GRV    GRAVE
// #define COLN   COLON
#define CIRC   CARET
#define PERC   PERCENT

/* 複合キー・システムキーの短縮定義 */
#define CTL_LG2 &mt LCTRL LANG2        // ctrl 英字
#define SFT_SPC &mt LSHIFT SPACE       // shift space
#define LSY_ENT &lt 3 ENTER            // レイヤ3 enter
#define LNM_LG1 &lt 2 LANG1            // レイヤ2 かな
#define BITWAR  &kp LS(LA(F))          // shift alt f
#define LSUP    &kp LS(UP)             // shift 上
#define LSDOWN  &kp LS(DOWN)           // shift 下
#define LSLEFT  &kp LS(LEFT)           // shift 左
#define LSRIGHT &kp LS(RIGHT)          // shift 右
#define LGLEFT  &kp LG(LEFT)           // win 左
#define LGRIGHT &kp LG(RIGHT)          // win 右
#define LALEFT  &kp LA(LEFT)           // alt 左
#define LARIGHT &kp LA(RIGHT)          // alt 右

keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T             &kp Y     &kp U     &kp I     &kp O     &kp P     &kp BSPC
&mo L_CS  &kp A     &kp S     &kp D     &kp F     &kp G             &kp H     &kp J     &kp K     &kp L     &kp QUES  &mo L_CS
&mo L_NM  &kp Z     &kp X     &kp C     &kp V     &kp B             &kp N     &kp M     &mkp MB1  &mkp MB2  &mo L_SR  &mo L_NM
          &kp LGUI  &kp LALT  &mo L_SC  CTL_LG2   SFT_SPC           LSY_ENT   LNM_LG1   &none     &none     &mo L_CF
            >;
        };

        CUSTOM {
            bindings = <
&none     &none     &kp F2    &kp PGUP  &kp ENT   &kp TAB           &none     &kp F7    &kp UP    &kp ENT   &none     &none
&none     &none     &kp HOME  &kp DEL   &kp END   &none             &kp BSPC  &kp LEFT  &kp DOWN  &kp RGHT  &none     &none
&none     &none     &kp PSCR  &kp PGDN  &none     &none             &kp MINS  &kp EQL   &kp COMM  &kp DOT   &kp SLSH  &none
          &trans    &trans    &trans    &trans    &trans            &trans    &trans    &none     &none     &none
            >;
        };

        NUMBER {
            bindings = <
&none     &kp F1    &kp F2    &kp F3    &kp F4    &kp F5            &kp N1    &kp N2    &kp N3    &kp N4    &kp N5    &none
&none     &kp F6    &kp F7    &kp F8    &kp F9    &kp F10           &kp N6    &kp N7    &kp N8    &kp N9    &kp N0    &none
&none     &kp F11   &kp F12   &none     &none     &none             &kp PLUS  &kp ASTR  &kp LT    &kp GT    &kp UNDS  &none
          &trans    &trans    &trans    &trans    &trans            &trans    &trans    &none     &none     &none
            >;
        };

        SYMBOL {
            bindings = <
&none     &kp SQT   &kp DQT   &kp EXCL  &none     &kp TILD          &kp BSLH  &kp LBKT  &kp RBKT  &none     &kp PERC  &none
&none     &kp AT    &kp SEMI  &kp DLLR  &none     &kp GRV           &kp HASH  &kp LPAR  &kp RPAR  &none     &kp PIPE  &none
&none     &none     &none     &kp COLN  &kp CIRC  &none             &kp AMPS  &kp LBRC  &kp RBRC  &none     &none     &none
          &trans    &trans    &trans    &trans    &trans            &trans    &trans    &none     &none     &none
            >;
        };

        SHORTCUT {
            bindings = <
&none     &none     &none     &none     &none     &none             &none     LGLEFT    LSUP      LGRIGHT  &none     &none
&none     &none     &none     &none     BITWAR   &none             &none      LSLEFT    LSDOWN    LSRIGHT  &none     &none
&none     &none     &none     &none     &none     &none             &none     &none     &none     &none     &none     &none
          &trans    &trans    &trans    &trans    &trans            &trans    &trans    &none     &none     &none
            >;
        };

        BLUETOOTH {
            bindings = <
&none     &none     &none     &none     &none     &none             &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4  &none
&none     &none     &none     &none     &none     &none             &bt BT_CLR &none     &none     &none     &none     &none
&none     &none     &none     &none     &none     &none             &none     &none     &none     &none     &none     &none
          &trans    &trans    &trans    &trans    &trans            &trans    &trans    &none     &none     &none
            >;
        };

        SCROLL {
            bindings = <
&kp ESC   &kp Q     &kp W     &kp E     &kp R     &kp T             &none     &none     &none     &none     &none     &none
&none     &kp A     &kp S     &kp D     &kp F     &kp G             &none     &none     &none     &none     &none     &none
&none     &kp Z     &kp X     &kp C     &kp V     &kp B             &none     &mkp MB3  LALEFT    LARIGHT   &none     &none
            &trans   &trans   &kp LALT  &kp LCTL  &kp SPC           &trans    &trans    &none     &none     &none
            >;
        };

    };
};